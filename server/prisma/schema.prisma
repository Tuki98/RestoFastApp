// RestobarService — Modelo de datos
// Learn more about Prisma: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Autenticación y permisos (RBAC) ----------

enum RoleName {
  ADMIN
  GERENTE
  CAJA
  MESERO
  COCINA
  SUPERADMIN
}

model Role {
  id        String   @id @default(uuid())
  name      RoleName @unique
  label     String
  createdAt DateTime @default(now())
  users     User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // ej: "orders:create"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ---------- Organizaciones (multi-tenencia) ----------

enum OrgPlan {
  TRIAL
  ACTIVE
  PAUSED
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  plan         OrgPlan  @default(TRIAL)
  trialEndsAt  DateTime?
  maxUsers     Int? // null = sin límite
  usersPanelPasswordHash String? // contraseña de acceso a la gestión de usuarios
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users            User[]
  categories       Category[]
  products         Product[]
  ingredients      Ingredient[]
  restaurantTables RestaurantTable[]
  reservations     Reservation[]
  orders           Order[]
  cashSessions     CashSession[]
  printers         Printer[]
}

model User {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  name           String
  email          String       @unique
  passwordHash   String
  active         Boolean      @default(true)
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  ordersCreated  Order[]   @relation("CreatedBy")
  ordersUpdated  OrderStatusHistory[]
  payments       Payment[]
  inventoryMovements InventoryMovement[]
  cashOpened     CashSession[] @relation("CashOpenedBy")
  cashClosed     CashSession[] @relation("CashClosedBy")
}

// ---------- Menú ----------

model Category {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  sortOrder      Int          @default(0)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  products       Product[]

  @@unique([organizationId, name])
}

model Product {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name           String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipe    RecipeItem[]
  orderItems OrderItem[]

  @@unique([categoryId, name])
}

// ---------- Inventario ----------

enum MovementType {
  IN
  OUT
}

// Área de inventario: cada insumo pertenece a una sola área (exclusivo por área).
enum InventoryArea {
  BARRA
  COCINA
}

model Ingredient {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  name           String
  unit           String // kg, l, pza, gr...
  area           InventoryArea  @default(BARRA) // Barra | Cocina
  stock          Decimal        @default(0) @db.Decimal(12, 3)
  minStock       Decimal        @default(0) @db.Decimal(12, 3)
  shelfLifeDays  Int?     // días que el insumo se conserva correctamente
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  recipeItems   RecipeItem[]
  movements     InventoryMovement[]
  lots          InventoryLot[]

  @@unique([organizationId, name])
}

// Lote = cada carga/entrada de inventario. Permite rastrear la fecha de
// ingreso y disparar alertas cuando la caducidad está cerca.
model InventoryLot {
  id           String    @id @default(uuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Decimal   @db.Decimal(12, 3)
  remaining    Decimal   @db.Decimal(12, 3)
  receivedAt   DateTime  @default(now()) // fecha de ingreso
  expiresAt    DateTime? // = receivedAt + shelfLifeDays
  exitedAt     DateTime? // fecha de salida: cuando el lote se agota
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  movements    InventoryMovement[]
}

model RecipeItem {
  id           String     @id @default(uuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity     Decimal    @db.Decimal(12, 3)

  @@unique([productId, ingredientId])
}

model InventoryMovement {
  id           String         @id @default(uuid())
  ingredientId String
  ingredient   Ingredient     @relation(fields: [ingredientId], references: [id])
  lotId        String?
  lot          InventoryLot?  @relation(fields: [lotId], references: [id])
  type         MovementType
  quantity     Decimal        @db.Decimal(12, 3)
  area         InventoryArea  @default(BARRA) // snapshot del área al momento del movimiento (trazabilidad)
  note         String?
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  createdAt    DateTime       @default(now())
}

// ---------- Mesas, QR y reservaciones ----------

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
}

model RestaurantTable {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  number         Int
  seats          Int
  section        String        @default("Interior")
  status         TableStatus   @default(FREE)
  qrToken        String        @unique
  occupiedViaQrAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  orders      Order[]
  reservations Reservation[]

  @@unique([organizationId, number])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Reservation {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  tableId        String
  table          RestaurantTable   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String?
  date          DateTime
  guests        Int
  status        ReservationStatus @default(PENDING)
  notes         String?
  createdAt     DateTime          @default(now())
}

// ---------- Órdenes y pagos ----------

enum OrderType {
  DINE_IN
  TAKEOUT
}

enum OrderStatus {
  PENDING
  IN_PREPARATION
  READY
  SERVED
  PAID
  CANCELLED
  AWAITING_CONFIRMATION
}

model Order {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  folio          Int          @unique @default(autoincrement())
  orderType      OrderType
  tableId        String?
  table          RestaurantTable? @relation(fields: [tableId], references: [id])
  status         OrderStatus  @default(PENDING)
  notes         String?
  customerToken String?      @unique // token del cliente para consultar el estado de su pedido
  subtotal      Decimal    @db.Decimal(10, 2)
  tax           Decimal    @default(0) @db.Decimal(10, 2)
  total         Decimal    @db.Decimal(10, 2)
  createdById   String?
  createdBy     User?      @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  paidAt        DateTime?

  items      OrderItem[]
  statusHistory OrderStatusHistory[]
  payments   Payment[]
}

model OrderItem {
  id          String    @id @default(uuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  productName String // snapshot del nombre al momento de ordenar
  unitPrice   Decimal   @db.Decimal(10, 2)
  quantity    Int
  notes       String?
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  changedAt DateTime    @default(now())
  changedById String?
  changedBy User?       @relation(fields: [changedById], references: [id])
}

enum PaymentMethod {
  CASH
  CARD
  YAPE_PLIN
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method      PaymentMethod
  amount      Decimal       @db.Decimal(10, 2)
  folio       Int           @unique @default(autoincrement())
  receivedById String
  receivedBy  User          @relation(fields: [receivedById], references: [id])
  paidAt      DateTime      @default(now())
}

// ---------- Caja ----------

// Sesión de caja: abre con la caja chica (efectivo inicial) y acumula los
// cobros (Pagos) realizados entre apertura y cierre. Al cerrar se guarda un
// snapshot de los totales por método de pago.
model CashSession {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  openedAt       DateTime     @default(now())
  closedAt       DateTime?
  openingBalance Decimal   @default(0) @db.Decimal(10, 2) // caja chica inicial
  closingCash    Decimal?  @db.Decimal(10, 2) // snapshot: efectivo al cerrar
  closingCard    Decimal?  @db.Decimal(10, 2) // snapshot: tarjeta al cerrar
  closingYape    Decimal?  @db.Decimal(10, 2) // snapshot: yape/plin al cerrar
  countedCash    Decimal?  @db.Decimal(10, 2) // efectivo contado físicamente al cerrar
  cashDifference Decimal?  @db.Decimal(10, 2) // sobre/faltante: contado - esperado
  ordersCount    Int?
  openedById     String
  openedBy       User      @relation("CashOpenedBy", fields: [openedById], references: [id])
  closedById     String?
  closedBy       User?     @relation("CashClosedBy", fields: [closedById], references: [id])
  createdAt      DateTime  @default(now())

  @@index([openedAt])
}

// ---------- Impresoras ----------

model Printer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  zone           String // "kitchen" | "cashier"
  host           String
  port           Int          @default(9100)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
}
